{
  "rewrites": [
    { "source": "/docs/(.*)", "destination": "/src/docs/$1" },
    { "source": "/docs", "destination": "/src/docs/index.html" },

    {
      "source": "/styles/(.*)",
      "destination": "/src/docs/styles/$1"
    },
    {
      "source": "/scripts/(.*)",
      "destination": "/src/docs/scripts/$1"
    },
    { "source": "/(.*)", "destination": "/src/$1" }
  ]
}