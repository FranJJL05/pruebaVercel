{
  "buildCommand": "npm run docs",
  
  "outputDirectory": "src",
  
  "rewrites": [
    {
      "source": "/docs/(.*)",
      "destination": "/docs/$1"
    },
    {
      "source": "/docs",
      "destination": "/docs/index.html"
    },
    
    {
      "source": "/(.*)",
      "destination": "/src/$1"
    }
  ]
}