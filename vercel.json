{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "buildCommand": "npm run vercel-build" 
      }
    }
  ],
  
  "rewrites": [
    {
      "source": "/docs/(.*)",
      "destination": "/docs/$1"
    },
    {
      "source": "/docs",
      "destination": "/docs/index.html"
    },

    {
      "source": "/(.*)",
      "destination": "/src/$1"
    }
  ]
}